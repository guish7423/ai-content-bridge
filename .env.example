# ── LLM API ───────────────────────────────────────────────────────────────
LLM_API_KEY=your-deepseek-api-key
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Mock mode (no real API calls — safe for testing)
LLM_API_MOCK=true

# ── App ───────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=generate-a-random-secret-here

# Railway auto-provides this; for local dev use SQLite
DATABASE_URL=sqlite:///./content_bridge.db

# Used for Stripe redirect URLs and OG meta tags
APP_URL=http://localhost:8000

# ── Stripe (REQUIRED for payments) ────────────────────────────────────────
STRIPE_API_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STARTER_PRICE_ID=price_starter_monthly_xxx
STRIPE_PRO_PRICE_ID=price_pro_monthly_xxx
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# ── Social API Keys (optional — for direct publishing) ────────────────────
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_USER_ID=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USERNAME=

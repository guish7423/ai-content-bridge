# LLM API (DeepSeek)
LLM_API_KEY=your-deepseek-api-key
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Mock mode (no real API calls)
LLM_API_MOCK=true

# App
DEBUG=true
SECRET_KEY=change-this-in-production

# Social API Keys (optional, for actual posting)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USERNAME=
